# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://admin:rootpassword@localhost:5432/music_store"
# Generate a local secret with: node scripts/setup-env.mjs
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Public canonical address for sitemap, product metadata and shared links.
SITE_URL="http://localhost:3000"
# Enable only when a trusted reverse proxy replaces x-forwarded-for.
TRUST_PROXY="false"
